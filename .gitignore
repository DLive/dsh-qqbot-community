# ──────────────────────────────────────────────────────────────────────────────
# dsh-qqbot-community — standard Node.js / TypeScript plugin .gitignore
# Covers: dependencies, build output, logs, OS / editor cruft, env, coverage.
# ──────────────────────────────────────────────────────────────────────────────

# ── Dependencies ──────────────────────────────────────────────────────────────
# Installed by npm install; reproducible from package-lock.json.
node_modules/
jspm_packages/

# ── Build output ──────────────────────────────────────────────────────────────
# TypeScript emits to lib/; rebuild with `npm run build`.
lib/
dist/
build/
out/
*.tsbuildinfo

# ── Test / coverage output ────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Runtime / state files (operator-side; never in source) ───────────────────
# QQ routes / session index / always-allow lists / ref index live under
# ~/.dsh/storages/ rather than the repo, but keep these wildcards in case a
# developer runs the plugin in-tree for debugging.
*.pid
*.seed
*.pid.lock
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Local environment / secrets ──────────────────────────────────────────────
.env
.env.*
!.env.example
.envrc

# ── Cache / temp directories ─────────────────────────────────────────────────
.cache/
.temp/
.tmp/
.parcel-cache/
.eslintcache
.stylelintcache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
.tsbuild/
node-gyp/

# ── Editor / IDE ──────────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Optional npm / yarn / pnpm metadata (uncomment if not used) ──────────────
# npm
npm-shrinkwrap.json
# yarn
yarn.lock
# pnpm
pnpm-lock.yaml